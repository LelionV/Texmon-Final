+class ReferenceDocumentTextFormMixin(forms.ModelForm):
+    """
+    Lets a document form (quotation, proforma) take the reference as free
+    text instead of a fixed dropdown.
+
+    - The user types any reference (e.g. "Client PO #4021").
+    - Existing Reference Documents are offered as suggestions via a datalist.
+    - On save, the text is matched (case-insensitively) to an existing
+      ReferenceDocument, or a new one is created automatically. That new one
+      then appears in the suggestions, so it can be reused without creating
+      a duplicate.
+
+    Subclasses must leave ``reference_document`` out of their Meta.fields.
+    The form drives that relation through ``reference_document_name`` instead.
+    """
+    reference_document_name = forms.CharField(
+        required=False, max_length=150, label="Reference Document",
+        help_text="Type a reference or pick a previous one. A new reference is saved automatically the first time you use it.",
+        widget=forms.TextInput(attrs={
+            "class": "form-control", "list": "reference-document-suggestions",
+            "placeholder": "e.g. Client PO #4021", "autocomplete": "off",
+        }),
+    )
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        from .models import ReferenceDocument
+        self.reference_suggestions = list(
+            ReferenceDocument.objects.filter(is_active=True).values_list("name", flat=True)
+        )
+        if self.instance.pk and self.instance.reference_document_id:
+            self.fields["reference_document_name"].initial = self.instance.reference_document.name
+
+    def save(self, commit=True):
+        from .models import ReferenceDocument
+        name = self.cleaned_data.get("reference_document_name", "")
+        self.instance.reference_document = ReferenceDocument.get_or_create_by_name(name)
+        return super().save(commit=commit)
