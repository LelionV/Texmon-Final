@@ -302,6 +310,22 @@ class ReferenceDocument(AuditModel):
     def __str__(self):
         return self.name
 
+    @classmethod
+    def get_or_create_by_name(cls, name):
+        """
+        Resolve free-typed reference text to a ReferenceDocument. An existing
+        document with the same name (case-insensitive) is reused so the same
+        reference never gets duplicated; otherwise a new one is created so it
+        shows up in the suggestions for next time.
+        """
+        name = (name or "").strip()
+        if not name:
+            return None
+        existing = cls.objects.filter(name__iexact=name).first()
+        if existing:
+            return existing
+        return cls.objects.create(name=name)
+
 
